# Copie para .env.local e preencha. Nunca coloque valores reais neste arquivo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SMTP da Terra: confirme host e porta no painel da Terra (normalmente smtp.terra.com.br, porta 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=top@topusinagem.com
EMAIL_SENDING_ENABLED=false
